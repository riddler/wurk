{
  "wurk": 1,
  "beads": {
    "prefix": "zz"
  },
  "forge": {
    "kind": "gitlab"
  },
  "gate": {
    "full": [
      "make",
      "check"
    ],
    "loop": [
      "make",
      "quick"
    ]
  },
  "parallelism": {
    "model": "branch-in-place"
  },
  "artifacts": {
    "plans": "docs/plans",
    "research": "docs/research"
  },
  "changelog": {
    "mode": "none"
  }
}
