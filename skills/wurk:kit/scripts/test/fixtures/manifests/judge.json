{
  "wurk": 1,
  "beads": { "prefix": "zz" },
  "forge": { "kind": "github" },
  "gate": { "full": ["make", "check"], "loop": ["make", "quick"] },
  "parallelism": { "model": "worktree-per-issue" },
  "artifacts": { "plans": "docs/plans", "research": "docs/research" },
  "changelog": { "mode": "none" },
  "judge": {
    "model": "faketool-model",
    "registry": [
      {
        "key": "rule-one",
        "label": "RULE-ONE",
        "scope_prefix": "docs/rules/",
        "scope_suffix": "RULE.md",
        "text": "docs/rules/rule-one.md",
        "focus": "a fake focus string for testing, not a restatement of any real rule"
      }
    ]
  }
}
