{
  "wurk": 1,

  "beads": {
    "prefix": "wu",
    "topology": "beads",
    "areas": {
      "labels": [
        "area:kit",
        "area:skills",
        "area:agents",
        "area:docs",
        "area:install"
      ],
      "lands_alone": ["area:install"],
      "always_batchable": []
    }
  },

  "forge": {
    "kind": "github",
    "labels": {}
  },

  "gate": {
    "full": ["ruby", "skills/wurk:kit/scripts/test/run.rb"],
    "loop": ["ruby", "skills/wurk:kit/scripts/test/run.rb"],
    "build_paths": ["skills/wurk:kit/scripts/"],
    "also_gated_paths": [],
    "moving_files": []
  },

  "parallelism": {
    "model": "worktree-per-issue",
    "worktrees_dir": "../wurk-worktrees",
    "post_branch": []
  },

  "tmux": {
    "session": "wurk",
    "model": "opus"
  },

  "models": {
    "direction": "fable"
  },

  "artifacts": {
    "plans": "docs/plans",
    "research": "docs/research"
  },

  "commits": {
    "style": "s-form",
    "trailer": {
      "key": "Refs"
    }
  },

  "changelog": {
    "mode": "none"
  },

  "release": null,

  "judge": {
    "model": "sonnet",
    "registry": [
      {
        "key": "adr-0008",
        "label": "ADR-0008",
        "scope_prefix": "skills/",
        "scope_suffix": "SKILL.md",
        "text": "docs/adr/0008-merge-time-judge-over-generic-skill-prose.md",
        "focus": "a step that used to state a policy call, a human gate, or a verification discipline now handing it to a script, or deleted during a rewrite rather than restated - including prose that turns a discipline into a check on its own artifact"
      }
    ]
  }
}
